# Thông tin tài khoản
FB_EMAIL=your_email@gmail.com
FB_PASSWORD=your_password
FB_2FA_SECRET=your_2fa_secret_if_enabled

# ID Facebook cá nhân (lấy từ link profile)
ADMIN_ID=1000xxxxxxxxx

# Cấu hình bot
BOT_NAME=🤖 Bot Cá Nhân
BOT_PREFIX=/
AUTO_REPLY=true
READ_MESSAGE=true
AUTO_SEEN=true

# Delay giữa các tin nhắn (ms)
MESSAGE_DELAY=1000

# Port cho web server
PORT=3000
